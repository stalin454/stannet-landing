{
  "main": "mailer.mjs",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [],
  "vars": {"MODE":"sandbox", "MAIL_RELEASE":"disabled"}
  // Dedicated service only: RESEND_DEV_API_KEY and DEV_MAILER_AUTH as secrets.

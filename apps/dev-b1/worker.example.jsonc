{
  // Preparation only: no account, Worker name, routes, database IDs or domain are assumed.
  "main": "worker.mjs",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory":"./assets-build", "binding":"DEV_ASSETS", "run_worker_first":true},
  "vars":{"MODE":"sandbox", "AUTH_RELEASE":"disabled"}
  // PUBLIC_ORIGIN, DEV_ENVIRONMENT_ID, dedicated DEV_DB and DEV_MAILER must be verified and bound before preview.
  // Never add production routes/credentials or deploy this with Space configuration.
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stannet-landing",
  "main": "worker.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "stannet.space",
      "custom_domain": true
    },
    {
      "pattern": "www.stannet.space",
      "custom_domain": true
    }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stannet-landing",
  "main": "worker.js",
  "compatibility_date": "2026-09-24",
  "vars": {
    "AI_API_URL": "https://api.groq.com/openai/v1/chat/completions",
    "AI_MODEL": "openai/gpt-oss-20b",
    "ALLOWED_ORIGIN": "https://www.stannet.space",
    "AZURE_SPEECH_REGION": "northeurope",
    "COMMUNITY_SUPABASE_URL": "https://tmldtlsrrgvyzuwljtur.supabase.co",
    "COMMUNITY_SUPABASE_KEY": "sb_publishable_GGYWVnox5he2lp3sy0aidw_p28CkC8M"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "stannet.space/*",
      "zone_name": "stannet.space"
    },
    {
      "pattern": "www.stannet.space/*",
      "zone_name": "stannet.space"
    }
  ],
  "workers_dev": true,
  "keep_vars": true,
  "previews": {
    "vars": {
      "AI_API_URL": "https://api.groq.com/openai/v1/chat/completions",
      "AI_MODEL": "openai/gpt-oss-20b",
      "AZURE_SPEECH_REGION": "northeurope",
      "COMMUNITY_SUPABASE_URL": "https://tmldtlsrrgvyzuwljtur.supabase.co",
      "COMMUNITY_SUPABASE_KEY": "sb_publishable_GGYWVnox5he2lp3sy0aidw_p28CkC8M"
    }
  }
}

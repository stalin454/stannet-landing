{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stannet-landing",
  "main": "worker.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "stannet.space/*",
      "zone_name": "stannet.space"
    },
    {
      "pattern": "www.stannet.space/*",
      "zone_name": "stannet.space"
    }
  ],
  "workers_dev": true
}

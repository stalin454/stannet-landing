{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stannet-landing",
  "main": "worker.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
